{
    "workbench.colorCustomizations": {
        "editor.background": "#16130b",
        "sideBar.background": "#16130b",
        "sideBar.border": "#16130b",
        "activityBar.background": "#16130b",
        "activityBar.border": "#16130b",
        "editorGroupHeader.tabsBackground": "#16130b",
        "editorGroupHeader.tabsBorder": "#16130b",
        "tab.activeBackground": "#16130b",
        "tab.activeBorder": "#dcc66e",
        "tab.inactiveBackground": "#16130b",
        "editorLineNumber.foreground": "#2d2a21",
        "editorLineNumber.activeForeground": "#dcc66e",
        "editorCursor.foreground": "#dcc66e",
        "editor.selectionBackground": "#54460066"
    },

    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                // Balises HTML (p, div, html, doctype)
                "scope": [
                    "entity.name.tag",
                    "meta.tag.sgml.doctype.html",
                    "punctuation.definition.tag"
                ],
                "settings": {
                    "foreground": "#dcc66e",
                    "fontStyle": "bold"
                }
            },
            {
                // Attributs HTML (class, id, src)
                "scope": "entity.other.attribute-name",
                "settings": {
                    "foreground": "#d2c6a1"
                }
            },
            {
                // Texte à l'intérieur des balises
                "scope": "text.html.derivative",
                "settings": {
                    "foreground": "#e9e2d4"
                }
            },
            {
                // Commentaires
                "scope": "comment",
                "settings": {
                    "foreground": "#969080",
                    "fontStyle": "italic"
                }
            }
        ]
    },

    // --- Ton interface Minimaliste ---
    "workbench.activityBar.location": "hidden",
    "workbench.statusBar.visible": false,
    "editor.minimap.enabled": false,
    "editor.scrollbar.vertical": "hidden",
    "editor.glyphMargin": false,
    "editor.folding": false,
    "breadcrumbs.enabled": false,
    "workbench.editor.showTabs": "single",
    "window.menuBarVisibility": "toggle",
    "window.commandCenter": false,
    "workbench.layoutControl.enabled": false,
    "editor.lineNumbers": "on",
    "editor.fontFamily": "JetBrainsMono Nerd Font",
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.padding.top": 25,
    "workbench.iconTheme": "material-icon-theme",
    "workbench.productIconTheme": "material-product-icons",
    "git.enableSmartCommit": true
}
