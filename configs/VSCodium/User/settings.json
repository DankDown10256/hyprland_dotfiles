  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": ["keyword", "keyword.control", "keyword.operator.new", "storage.type", "storage.modifier"],
        "settings": { "foreground": "#a0cafd", "fontStyle": "bold" }
      },
      {
        "scope": ["string", "string.quoted", "string.template"],
        "settings": { "foreground": "#d6bee4" }
      },
      {
        "scope": ["constant.numeric", "constant.language", "constant.character"],
        "settings": { "foreground": "#bbc7db" }
      },
      {
        "scope": ["entity.name.function", "meta.function-call entity.name.function", "support.function"],
        "settings": { "foreground": "#e1e2e8" }
      },
      {
        "scope": ["entity.name.type", "entity.name.class", "entity.name.interface", "support.type", "support.class"],
        "settings": { "foreground": "#d6bee4" }
      },
      {
        "scope": ["variable", "variable.other", "variable.parameter"],
        "settings": { "foreground": "#e1e2e8" }
      },
      {
        "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key"],
        "settings": { "foreground": "#c3c7cf" }
      },
      {
        "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"],
        "settings": { "foreground": "#a0cafd" }
      },
      {
        "scope": ["entity.name.tag", "meta.tag.sgml.doctype.html", "punctuation.definition.tag"],
        "settings": { "foreground": "#a0cafd", "fontStyle": "bold" }
      },
      {
        "scope": ["entity.other.attribute-name", "entity.other.attribute-name.html"],
        "settings": { "foreground": "#c3c7cf" }
      },
      {
        "scope": "comment",
        "settings": { "foreground": "#8d9199", "fontStyle": "italic" }
      },
      {
        "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"],
        "settings": { "foreground": "#e1e2e8", "fontStyle": "italic" }
      },
      {
        "scope": ["entity.other.attribute-name.class.css", "entity.name.tag.css"],
        "settings": { "foreground": "#d6bee4" }
      },
      {
        "scope": "support.type.property-name.css",
        "settings": { "foreground": "#c3c7cf" }
      },
      {
        "scope": ["support.constant.property-value.css", "constant.other.color.rgb-value.css"],
        "settings": { "foreground": "#d6bee4" }
      }
    ]
  },

  "editor.semanticHighlighting.enabled": true,
  "editor.semanticTokenColorCustomizations": {
    "rules": {
      "function":          { "foreground": "#e1e2e8" },
      "method":            { "foreground": "#e1e2e8" },
      "class":             { "foreground": "#d6bee4" },
      "interface":         { "foreground": "#d6bee4", "fontStyle": "italic" },
      "type":              { "foreground": "#d6bee4" },
      "enum":              { "foreground": "#d6bee4" },
      "enumMember":        { "foreground": "#bbc7db" },
      "variable":          { "foreground": "#e1e2e8" },
      "variable.readonly": { "foreground": "#bbc7db" },
      "parameter":         { "foreground": "#e1e2e8", "fontStyle": "italic" },
      "property":          { "foreground": "#c3c7cf" },
      "keyword":           { "foreground": "#a0cafd", "fontStyle": "bold" },
      "string":            { "foreground": "#d6bee4" },
      "number":            { "foreground": "#bbc7db" },
      "comment":           { "foreground": "#8d9199", "fontStyle": "italic" },
      "decorator":         { "foreground": "#e1e2e8", "fontStyle": "italic" },
      "macro":             { "foreground": "#a0cafd" }
    }
  },

  "workbench.activityBar.location":           "default",
  "workbench.statusBar.visible":              true,
  "workbench.editor.showTabs":                "multiple",
  "workbench.editor.tabSizing":               "shrink",
  "workbench.editor.tabActionLocation":       "right",
  "workbench.editor.pinnedTabSizing":         "compact",
  "workbench.editor.highlightModifiedTabs":   true,
  "workbench.editor.decorations.colors":      true,
  "workbench.editor.decorations.badges":      true,
  "workbench.sideBar.location":               "left",

  "breadcrumbs.enabled":                      true,
  "breadcrumbs.filePath":                     "on",
  "breadcrumbs.symbolPath":                   "on",

  "editor.minimap.enabled":                   true,
  "editor.minimap.scale":                     1,
  "editor.minimap.renderCharacters":          false,
  "editor.minimap.maxColumn":                 80,
  "editor.minimap.showSlider":                "always",
  "editor.minimap.side":                      "right",

  "editor.scrollbar.vertical":                "auto",
  "editor.scrollbar.verticalScrollbarSize":   6,
  "editor.scrollbar.horizontal":              "auto",
  "editor.scrollbar.horizontalScrollbarSize": 6,

  "editor.glyphMargin":                       true,
  "editor.folding":                           true,
  "editor.foldingStrategy":                   "indentation",
  "editor.showFoldingControls":               "mouseover",

  "window.menuBarVisibility":                 "toggle",
  "window.commandCenter":                     false,
  "workbench.layoutControl.enabled":          false,

  "editor.lineNumbers":                       "on",
  "editor.fontFamily":                        "JetBrainsMono Nerd Font",
  "editor.fontSize":                          13.5,
  "editor.lineHeight":                        1.5,
  "editor.letterSpacing":                     0,
  "editor.cursorBlinking":                    "smooth",
  "editor.cursorSmoothCaretAnimation":        "on",
  "editor.cursorStyle":                       "line",
  "editor.cursorWidth":                       2,
  "editor.padding.top":                       25,
  "editor.padding.bottom":                    25,
  "editor.renderLineHighlight":               "all",
  "editor.renderWhitespace":                  "none",

  "editor.bracketPairColorization.enabled":   true,
  "editor.guides.bracketPairs":               "active",
  "editor.guides.indentation":                true,

  "editor.inlayHints.enabled":                "on",
  "editor.inlayHints.fontSize":               11,
  "editor.inlayHints.padding":                true,

  "editor.suggestSelection":                  "first",
  "editor.suggest.insertMode":                "replace",
  "editor.suggest.preview":                   true,
  "editor.acceptSuggestionOnEnter":           "on",
  "editor.tabCompletion":                     "on",
  "editor.parameterHints.enabled":            true,

  "editor.smoothScrolling":                   true,
  "workbench.list.smoothScrolling":           true,
  "workbench.activityBar.location":           "hidden",

  "workbench.iconTheme":                      "jetbrains-file-icon-theme-dark",
  "workbench.productIconTheme":               "material-product-icons"
