{
  // --- Interface ultra-propre ---
  "editor.minimap.enabled": false,
  "workbench.activityBar.location": "hidden",
  "workbench.statusBar.visible": false,
  "editor.glyphMargin": false,
  "editor.folding": false,
  "editor.lineNumbers": "on",
  
  // --- Cursor & IA Discrets ---
  "editor.lightbulb.enabled": "off",
  "cursor.cpp.enable": true,
  "cursor.showAiIconInEditor": false,
  
  // --- Focus et Zen ---
  "editor.occurrencesHighlight": "off",
  "editor.renderLineHighlight": "none",
  "editor.guides.indentation": false,
  "workbench.iconTheme": "material-icon-theme",
  "workbench.layoutControl.enabled": false,
  "window.menuBarVisibility": "compact",
  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",

  // --- Intégration Magique Matugen ---
  "workbench.colorCustomizations": {
    "editor.background": "#19120c",
    "editor.foreground": "#eee0d5",
    "editorLineNumber.foreground": "#9d8e81",
    "editorLineNumber.activeForeground": "#faba73",
    "editor.selectionBackground": "#58432c",
    "editorCursor.foreground": "#faba73",
    "sideBar.background": "#211a14",
    "sideBar.foreground": "#eee0d5",
    "titleBar.activeBackground": "#19120c",
    "titleBar.activeForeground": "#eee0d5"
  }
}
