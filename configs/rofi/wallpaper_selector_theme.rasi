@import "colors.rasi"

/*****----- Global Properties -----*****/
* {
    /* Alignement sur les variables de ton config.rasi */
    bg:                  @background;
    bg-sel:              @background-alt;
    fg:                  @foreground;
    fg-dim:              @selected;
    
    background-color:    transparent;
    text-color:          @fg;
    border-color:        @selected;

    font:                "JetBrains Mono 14"; /* Même police que ton menu d'apps */
}

/*****----- Main Window -----*****/
window {
    transparency:        "real";
    location:            center;
    anchor:              center;
    fullscreen:          false;
    width:               900px;
    height:              520px;
    
    /* Style copié sur ton config.rasi */
    background-color:    @bg;
    border:              1px;
    border-radius:       16px;
    border-color:        @border-color;
    cursor:              "default";
}

/*****----- Main Box -----*****/
mainbox {
    orientation:         horizontal;
    spacing:             0px;
    margin:              0px;
    padding:             0px;
    background-color:    transparent;
    children:            [ "listbox", "preview" ];
}

/*****----- Colonne gauche -----*****/
listbox {
    orientation:         vertical;
    width:               340px;
    spacing:             0px;
    padding:             16px; /* Plus proche des paddings de ton config */
    background-color:    transparent;
    children:            [ "inputbar", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:             true;
    spacing:             10px;
    margin:              0px 0px 10px 0px;
    padding:             12px 16px;
    border:              0 0 1px 0; /* Bordure discrète du bas comme config.rasi */
    border-color:        #3a3a3c;
    background-color:    transparent;
    text-color:          @fg;
    children:            [ "prompt", "entry" ];
}

prompt {
    enabled:             true;
    padding:             0px;
    background-color:    transparent;
    text-color:          @fg-dim;
}

entry {
    enabled:             true;
    background-color:    transparent;
    text-color:          inherit;
    cursor:              text;
    placeholder:         "Rechercher...";
    placeholder-color:   @fg-dim;
}

/*****----- Listview -----*****/
listview {
    enabled:             true;
    columns:             1;
    lines:               8;
    cycle:               true;
    dynamic:             true;
    scrollbar:           false;
    layout:              vertical;
    fixed-height:        true;
    fixed-columns:       true;
    spacing:             2px;
    background-color:    transparent;
}

/*****----- Elements -----*****/
element {
    enabled:             true;
    spacing:             12px;
    padding:             10px 16px; /* Strictement calqué sur config.rasi */
    border-radius:       8px;       /* Même rayon pour les sélections */
    background-color:    transparent;
    text-color:          @fg;
    cursor:              pointer;
}

element selected.normal {
    background-color:    @bg-sel;
}

element selected.normal element-text {
    text-color:          @fg;
    font:                "JetBrains Mono Bold 14"; /* Effet de gras à la sélection */
}

element-icon {
    background-color:    transparent;
    text-color:          inherit;
    size:                28px; /* Taille cohérente avec le menu app */
    cursor:              inherit;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    vertical-align:      0.5;
    cursor:              inherit;
}

/*****----- Colonne droite : preview -----*****/
preview {
    orientation:         vertical;
    expand:              true;
    padding:             20px;
    /* Suppression du fond solide pour garder l'aspect épuré global */
    background-color:    transparent; 
    border:              0 0 0 1px; /* Ligne de séparation subtile à gauche */
    border-color:        #3a3a3c;
    children:            [ "icon-current-entry" ];
}

icon-current-entry {
    expand:              true;
    size:                420px;
    border-radius:       12px;
    background-color:    transparent;
}
