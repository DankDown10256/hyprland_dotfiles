@import "colors.rasi"

/*****----- Global Properties -----*****/
* {
    /* Alignement sur tes variables */
    bg:                  @background;
    bg-sel:              @background-alt;
    fg:                  @foreground;
    fg-dim:              @selected;
    
    background-color:    transparent;
    text-color:          @fg;
    border-color:        @selected;

    font:                "JetBrains Mono 12";
}

/*****----- Fenêtre Principale -----*****/
window {
    transparency:        "real";
    location:            center;
    anchor:              center;
    fullscreen:          false;
    
    /* Largeur de la fenêtre */
    width:               1000px; 
    height:              360px;
    
    background-color:    @bg;
    border:              1px;
    border-radius:       16px;
    border-color:        @border-color;
    cursor:              "default";
}

/*****----- Main Box -----*****/
mainbox {
    orientation:         vertical;
    spacing:             15px;
    padding:             20px;
    background-color:    transparent;
    children:            [ "inputbar", "listview" ];
}

/*****----- Barre de recherche -----*****/
inputbar {
    enabled:             true;
    spacing:             10px;
    padding:             5px 10px;
    border:              0px 0px 1px 0px; 
    border-color:        #3a3a3c;
    background-color:    transparent;
    text-color:          @fg;
    children:            [ "prompt", "entry" ];
}

prompt {
    enabled:             true;
    text-color:          @fg-dim;
}

entry {
    enabled:             true;
    placeholder:         "Rechercher un wallpaper...";
    placeholder-color:   @fg-dim;
    text-color:          @fg;
}

/*****----- Le Vrai Carrousel Horizontal -----*****/
listview {
    enabled:             true;
    cycle:               true;
    dynamic:             true;
    scrollbar:           false;
    
    /* LE FIX EST ICI : on enlève columns et lines pour laisser Rofi gérer le flux horizontal libre */
    layout:              horizontal; 
    
    spacing:             15px;
    background-color:    transparent;
}

/*****----- Les Éléments (Aperçus du carrousel) -----*****/
element {
    enabled:             true;
    orientation:         vertical; /* L'image au dessus, le texte en dessous */
    spacing:             8px;
    padding:             15px;
    border-radius:       12px;
    background-color:    transparent;
    
    /* On donne une largeur fixe aux vignettes pour forcer le défilement un par un */
    width:               220px; 
}

/* Force le fond transparent sur les éléments non sélectionnés */
element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active {
    background-color:    transparent;
    text-color:          @fg;
}

/* L'élément actuellement sélectionné */
element selected.normal,
element selected.active {
    background-color:    @bg-sel;
    border:              1px;
    border-color:        @fg-dim;
}

/* Vignette d'image */
element-icon {
    background-color:    transparent;
    text-color:          inherit;
    size:                140px; /* Taille de l'aperçu */
    cursor:              inherit;
    horizontal-align:    0.5;
}

/* Texte en dessous */
element-text {
    background-color:    transparent;
    text-color:          inherit;
    horizontal-align:    0.5;
    vertical-align:      0.5;
    cursor:              inherit;
    font:                "JetBrains Mono 10";
}

element selected.normal element-text,
element selected.active element-text {
    font:                "JetBrains Mono Bold 10";
    text-color:          @fg-dim;
}
