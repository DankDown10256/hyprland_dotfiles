@import "colors.rasi"

/*****----- Global Properties -----*****/
* {
    /* Alignement sur tes variables */
    bg:                  @background;
    bg-sel:              @background-alt;
    fg:                  @foreground;
    fg-dim:              @selected;
    
    background-color:    transparent;
    text-color:          @fg;
    border-color:        @selected;

    font:                "JetBrains Mono 12";
}

/*****----- Fenêtre Principale -----*****/
window {
    transparency:        "real";
    location:            center;
    anchor:              center;
    fullscreen:          false;
    
    /* Fenêtre plus large et plus haute pour de grosses images */
    width:               1200px; 
    height:              520px;
    
    background-color:    @bg;
    border:              2px;
    border-color:        @border-color;
    cursor:              "default";
}

/*****----- Main Box -----*****/
mainbox {
    orientation:         vertical;
    spacing:             20px;
    padding:             30px;
    background-color:    transparent;
    children:            [ "inputbar", "listview" ];
}

/*****----- Barre de recherche -----*****/
inputbar {
    enabled:             true;
    spacing:             10px;
    padding:             10px 15px;
    background-color:    @background-alt; /* Un peu plus sombre que le fond */
    text-color:          @fg;
    children:            [ "prompt", "entry" ];
}

prompt {
    enabled:             true;
    text-color:          @fg-dim;
    font:                "JetBrains Mono Bold 12";
}

entry {
    enabled:             true;
    placeholder:         "Rechercher un wallpaper...";
    placeholder-color:   @fg-dim;
    text-color:          @fg;
}

/*****----- Le Carrousel Horizontal -----*****/
listview {
    enabled:             true;
    cycle:               true;
    dynamic:             true;
    scrollbar:           false;
    layout:              horizontal; 
    
    spacing:             25px;
    background-color:    transparent;
}

/*****----- Les Éléments (Vignettes larges) -----*****/
element {
    enabled:             true;
    orientation:         vertical;
    spacing:             12px;
    padding:             20px;
    background-color:    transparent;
    
    /* Largeur fixe pour des aperçus imposants */
    width:               320px; 
}

/* Éléments non sélectionnés */
element normal.normal,
element alternate.normal {
    background-color:    transparent;
    text-color:          @fg;
}

/* L'élément sélectionné avec effet de focus */
element selected.normal {
    background-color:    @bg-sel;
    border:              2px;
    border-color:        @fg-dim;
}

/* Taille de l'image (Vraiment plus grande) */
element-icon {
    background-color:    transparent;
    size:                240px; /* On passe de 140px à 240px */
    cursor:              inherit;
    horizontal-align:    0.5;
}

/* Texte sous l'image */
element-text {
    background-color:    transparent;
    text-color:          inherit;
    horizontal-align:    0.5;
    vertical-align:      0.5;
    cursor:              inherit;
    font:                "JetBrains Mono 11";
}

element selected.normal element-text {
    font:                "JetBrains Mono Bold 12";
    text-color:          @fg-dim;
}
