configuration {
    modi:                       "drun,run,window";
    show-icons:                 true;
    display-drun:               "";
    display-run:                "";
    display-window:             "";
    drun-display-format:        "{name}";
    font:                        "JetBrainsMono Nerd Font 10";
}

@import "~/.config/rofi/colors.rasi"

* {
    background-color: transparent;
    text-color:       @foreground;
}

/* Fenêtre centrée et épurée */
window {
    width:            600px;
    height:           400px;
    border:           1px;
    border-color:     @background-alt; /* Bordure très discrète */
    border-radius:    10px;
    background-color: @background;
    padding:          20px;
}

mainbox {
    orientation:      vertical;
    children:         [ "inputbar", "listview" ];
    spacing:          15px;
    background-color: @background;
}

/* Barre de recherche minimaliste */
inputbar {
    spacing:          10px;
    padding:          5px;
    children:         [ "prompt", "entry" ];
    border:           0px 0px 1px 0px; 
    border-color:     @background-alt;
    background-color: @background;
}

prompt {
    text-color:       @selected;
    background-color: transparent;
}

entry {
    placeholder:      "Rechercher...";
    placeholder-color: #5c6364;
    text-color:       @foreground;
    background-color: transparent;
}

/* Liste des applications très aérée */
listview {
    columns:          1;
    lines:            6;
    cycle:            true;
    dynamic:          true;
    layout:           vertical;
    spacing:          5px;
    background-color: transparent;
}

/* Style de base des lignes */
element {
    padding:          8px 12px;
    border-radius:    6px;
    spacing:          12px;
}

/* --- LE FIX POUR LE FOND BEIGE --- */
/* On force le fond transparent sur TOUS les éléments non sélectionnés */

element normal.normal, 
element alternate.normal {
    background-color: transparent;
    text-color:       @foreground;
}

element normal.active, 
element alternate.active {
    background-color: transparent;
    text-color:       @active;
}

element normal.urgent, 
element alternate.urgent {
    background-color: transparent;
    text-color:       @urgent;
}

/* --- STYLE DE L'ÉLÉMENT SÉLECTIONNÉ --- */
/* Le curseur colore le texte en cyan sur un fond gris très discret */

element selected.normal {
    background-color: @background-alt;
    text-color:       @selected;
}

element selected.active {
    background-color: @background-alt;
    text-color:       @selected;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @background;
}

/* Gestion des icônes et du texte */
element-icon {
    size:             22px;
    background-color: transparent;
}

element-text {
    vertical-align:   0.5;
    text-color:       inherit; /* Très important pour que le texte change de couleur au survol */
    background-color: transparent;
}
