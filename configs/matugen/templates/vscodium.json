  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": ["keyword", "keyword.control", "keyword.operator.new", "storage.type", "storage.modifier"],
        "settings": { "foreground": "{{ colors.primary.default.hex }}", "fontStyle": "bold" }
      },
      {
        "scope": ["string", "string.quoted", "string.template"],
        "settings": { "foreground": "{{ colors.tertiary.default.hex }}" }
      },
      {
        "scope": ["constant.numeric", "constant.language", "constant.character"],
        "settings": { "foreground": "{{ colors.secondary.default.hex }}" }
      },
      {
        "scope": ["entity.name.function", "meta.function-call entity.name.function", "support.function"],
        "settings": { "foreground": "{{ colors.on_surface.default.hex }}" }
      },
      {
        "scope": ["entity.name.type", "entity.name.class", "entity.name.interface", "support.type", "support.class"],
        "settings": { "foreground": "{{ colors.tertiary.default.hex }}" }
      },
      {
        "scope": ["variable", "variable.other", "variable.parameter"],
        "settings": { "foreground": "{{ colors.on_surface.default.hex }}" }
      },
      {
        "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key"],
        "settings": { "foreground": "{{ colors.on_surface_variant.default.hex }}" }
      },
      {
        "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"],
        "settings": { "foreground": "{{ colors.primary.default.hex }}" }
      },
      {
        "scope": ["entity.name.tag", "meta.tag.sgml.doctype.html", "punctuation.definition.tag"],
        "settings": { "foreground": "{{ colors.primary.default.hex }}", "fontStyle": "bold" }
      },
      {
        "scope": ["entity.other.attribute-name", "entity.other.attribute-name.html"],
        "settings": { "foreground": "{{ colors.on_surface_variant.default.hex }}" }
      },
      {
        "scope": "comment",
        "settings": { "foreground": "{{ colors.outline.default.hex }}", "fontStyle": "italic" }
      },
      {
        "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"],
        "settings": { "foreground": "{{ colors.on_surface.default.hex }}", "fontStyle": "italic" }
      },
      {
        "scope": ["entity.other.attribute-name.class.css", "entity.name.tag.css"],
        "settings": { "foreground": "{{ colors.tertiary.default.hex }}" }
      },
      {
        "scope": "support.type.property-name.css",
        "settings": { "foreground": "{{ colors.on_surface_variant.default.hex }}" }
      },
      {
        "scope": ["support.constant.property-value.css", "constant.other.color.rgb-value.css"],
        "settings": { "foreground": "{{ colors.tertiary.default.hex }}" }
      }
    ]
  },

  "editor.semanticHighlighting.enabled": true,
  "editor.semanticTokenColorCustomizations": {
    "rules": {
      "function":          { "foreground": "{{ colors.on_surface.default.hex }}" },
      "method":            { "foreground": "{{ colors.on_surface.default.hex }}" },
      "class":             { "foreground": "{{ colors.tertiary.default.hex }}" },
      "interface":         { "foreground": "{{ colors.tertiary.default.hex }}", "fontStyle": "italic" },
      "type":              { "foreground": "{{ colors.tertiary.default.hex }}" },
      "enum":              { "foreground": "{{ colors.tertiary.default.hex }}" },
      "enumMember":        { "foreground": "{{ colors.secondary.default.hex }}" },
      "variable":          { "foreground": "{{ colors.on_surface.default.hex }}" },
      "variable.readonly": { "foreground": "{{ colors.secondary.default.hex }}" },
      "parameter":         { "foreground": "{{ colors.on_surface.default.hex }}", "fontStyle": "italic" },
      "property":          { "foreground": "{{ colors.on_surface_variant.default.hex }}" },
      "keyword":           { "foreground": "{{ colors.primary.default.hex }}", "fontStyle": "bold" },
      "string":            { "foreground": "{{ colors.tertiary.default.hex }}" },
      "number":            { "foreground": "{{ colors.secondary.default.hex }}" },
      "comment":           { "foreground": "{{ colors.outline.default.hex }}", "fontStyle": "italic" },
      "decorator":         { "foreground": "{{ colors.on_surface.default.hex }}", "fontStyle": "italic" },
      "macro":             { "foreground": "{{ colors.primary.default.hex }}" }
    }
  },

  "workbench.activityBar.location":           "default",
  "workbench.statusBar.visible":              true,
  "workbench.editor.showTabs":                "multiple",
  "workbench.editor.tabSizing":               "shrink",
  "workbench.editor.tabActionLocation":       "right",
  "workbench.editor.pinnedTabSizing":         "compact",
  "workbench.editor.highlightModifiedTabs":   true,
  "workbench.editor.decorations.colors":      true,
  "workbench.editor.decorations.badges":      true,
  "workbench.sideBar.location":               "left",

  "breadcrumbs.enabled":                      true,
  "breadcrumbs.filePath":                     "on",
  "breadcrumbs.symbolPath":                   "on",

  "editor.minimap.enabled":                   true,
  "editor.minimap.scale":                     1,
  "editor.minimap.renderCharacters":          false,
  "editor.minimap.maxColumn":                 80,
  "editor.minimap.showSlider":                "always",
  "editor.minimap.side":                      "right",

  "editor.scrollbar.vertical":                "auto",
  "editor.scrollbar.verticalScrollbarSize":   6,
  "editor.scrollbar.horizontal":              "auto",
  "editor.scrollbar.horizontalScrollbarSize": 6,

  "editor.glyphMargin":                       true,
  "editor.folding":                           true,
  "editor.foldingStrategy":                   "indentation",
  "editor.showFoldingControls":               "mouseover",

  "window.menuBarVisibility":                 "toggle",
  "window.commandCenter":                     false,
  "workbench.layoutControl.enabled":          false,

  "editor.lineNumbers":                       "on",
  "editor.fontFamily":                        "JetBrainsMono Nerd Font",
  "editor.fontSize":                          13.5,
  "editor.lineHeight":                        1.5,
  "editor.letterSpacing":                     0,
  "editor.cursorBlinking":                    "smooth",
  "editor.cursorSmoothCaretAnimation":        "on",
  "editor.cursorStyle":                       "line",
  "editor.cursorWidth":                       2,
  "editor.padding.top":                       25,
  "editor.padding.bottom":                    25,
  "editor.renderLineHighlight":               "all",
  "editor.renderWhitespace":                  "none",

  "editor.bracketPairColorization.enabled":   true,
  "editor.guides.bracketPairs":               "active",
  "editor.guides.indentation":                true,

  "editor.inlayHints.enabled":                "on",
  "editor.inlayHints.fontSize":               11,
  "editor.inlayHints.padding":                true,

  "editor.suggestSelection":                  "first",
  "editor.suggest.insertMode":                "replace",
  "editor.suggest.preview":                   true,
  "editor.acceptSuggestionOnEnter":           "on",
  "editor.tabCompletion":                     "on",
  "editor.parameterHints.enabled":            true,

  "editor.smoothScrolling":                   true,
  "workbench.list.smoothScrolling":           true,
  "workbench.activityBar.location":           "hidden",

  "workbench.iconTheme":                      "jetbrains-file-icon-theme-dark",
  "workbench.productIconTheme":               "material-product-icons"
}
