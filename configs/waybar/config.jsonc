{
  "layer": "top",
  "position": "top",
  "height": 36,
  "margin-top": 6,
  "exclusive": true,

  "modules-left": [],
  "modules-center": ["clock","mpris","hyprland/workspaces","custom/claude", "pulseaudio", "network", "battery"],
  "modules-right": [],

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "sort-by-number": true,
    "format-icons": {
      "1": ">_",
      "2": "",
      "3": "",
      "4": "",
      "5": ""
    },
    "persistent-workspaces": {
      "*": [1,2,3,4,5]
    }
  },
  "mpris": {
  "format": "{player_icon} {artist} – {title}",
  "format-paused": "{player_icon} {artist} – {title}",
  "player-icons": {
    "default": "▶",
    "spotify": "",
    "firefox": "󰈹"
  },
  "status-icons": {
    "paused": "⏸"
  },
  "max-length": 40,
  "interval": 2
  },
  "pulseaudio": {
  "format": "{icon}",
  "format-muted": "󰝟",
  "format-icons": {
    "default": ["󰕿", "󰖀", "󰕾"]
  },
  "tooltip-format": "{volume}%",
  "on-click": "pavucontrol"
},

"network": {
  "format-wifi": "󰤨",
  "format-ethernet": "󰈀",
  "format-disconnected": "󰤭",
  "tooltip-format-wifi": "{essid}",
  "tooltip-format-ethernet": "{ifname}",
  "tooltip-format-disconnected": "Déconnecté"
},

"battery": {
  "format": "{icon}",
  "format-charging": "󰂄",
  "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
  "tooltip-format": "{capacity}%",
  "states": {
    "warning": 30,
    "critical": 15
  }
},
"custom/claude": {
  "exec": "python ~/.config/waybar/scripts/claude-usage.py",
  "return-type": "json",
  "format": "{}",
  "interval": 300,
  "tooltip": true
}
}
