{
    "layer": "bottom",
    "position": "bottom",
    "height": 24,
    "spacing": 0, // i3 n'a pas d'espace entre les modules

    "modules-left": ["hyprland/workspaces", "hyprland/submap"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["pulseaudio", "network", "cpu", "memory", "battery", "clock", "tray"],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "on-click": "activate"
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 50,
        "separate-outputs": true
    },

    "hyprland/submap": {
        "format": "MODE: {}"
    },

    "cpu": {
        "format": "CPU: {usage}%",
        "interval": 5
    },

    "memory": {
        "format": "RAM: {used:0.1f}G",
        "interval": 5
    },

    "network": {
        "format-wifi": "WLAN: {essid}",
        "format-ethernet": "ETH: {ifname}",
        "format-disconnected": "NO NET",
        "tooltip-format": "{ifname} via {gwaddr}"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "BAT: {capacity}%",
        "format-charging": "CHR: {capacity}%",
        "format-plugged": "AC: {capacity}%"
    },

    "pulseaudio": {
        "format": "VOL: {volume}%",
        "format-muted": "MUTE",
        "on-click": "pavucontrol"
    },

    "clock": {
        "format": "{:%Y-%m-%d %H:%M:%S}",
        "interval": 1,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "tray": {
        "icon-size": 14,
        "spacing": 10
    }
}
